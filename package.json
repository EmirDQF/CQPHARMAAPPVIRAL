{
  "name": "artikare",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "supabase test db && vitest run -c vitest.integration.config.ts",
    "db:rollback-check": "node scripts/db-rollback-check.mjs && supabase test db",
    "cap:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/cap-sync.mjs",
    "verify-env": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-env.ts",
    "verify:android-release": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-android-release.ts",
    "verify:version": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-version.mjs",
    "preflight": "npm run typecheck && npm run lint && npm test && npm run verify-env && npm run verify:version",
    "build:android": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-android-release.mjs",
    "mobile:dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mobile-dev.mjs",
    "mobile:install": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mobile-install.mjs",
    "mobile:verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mobile-verify.mjs",
    "build:mobile-web": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-mobile-web.mjs",
    "mobile:bundle": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/mobile-bundle.mjs",
    "release:package": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/package-release.mjs",
    "generate:android-assets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-android-assets.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
