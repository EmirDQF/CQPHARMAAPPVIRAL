<?xml version="1.0" encoding="utf-8"?>
<!-- Release (main): solo TLS, sin excepciones de cleartext. La variante debug lo
     sobreescribe en src/debug/res/xml para permitir loopback (adb reverse).
     Lo comprueba scripts/verify-android-release.ts. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
