# Número de WhatsApp del consultorio para los CTA del Test de Edad Articular.
# Formato internacional sin "+" ni espacios (ej. Perú: 51987654321).
NEXT_PUBLIC_WHATSAPP_NUMBER=51987654321

# URL pública del sitio (sin slash final), usada en metadata, OpenGraph,
# sitemap.xml y robots.txt.
NEXT_PUBLIC_SITE_URL=https://artikare.com

# ─── Supabase (Fase 1) ───────────────────────────────────────────────────────
# Sin estas variables la app sigue en modo invitado (solo localStorage).
# Local: `npx supabase start` y luego `npx supabase status` muestra los valores.
# Nunca subas .env.local al repositorio ni pegues claves en el chat.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (import "server-only"). NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Email OTP (Resend como SMTP de Supabase Auth) ───────────────────────────
RESEND_API_KEY=

# ─── Captcha (Cloudflare Turnstile) ──────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
