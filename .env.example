# Número de WhatsApp del consultorio para todos los botones de WhatsApp.
# Celular peruano en E.164 sin "+" ni espacios: 51 + 9 dígitos que empiezan en 9.
# Si queda vacío o es inválido, los botones se muestran deshabilitados con el aviso
# "WhatsApp no disponible por el momento" (no hay número de reserva).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL pública del sitio (sin slash final), usada en metadata, OpenGraph,
# sitemap.xml y robots.txt.
NEXT_PUBLIC_SITE_URL=https://artikare.com

# ─── Supabase (Fase 1) ───────────────────────────────────────────────────────
# Sin estas variables la app sigue en modo invitado (solo localStorage).
# Local: `npx supabase start` y luego `npx supabase status` muestra los valores.
# Nunca subas .env.local al repositorio ni pegues claves en el chat.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (import "server-only"). NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Email OTP (Resend como SMTP de Supabase Auth) ───────────────────────────
RESEND_API_KEY=

# ─── Captcha (Cloudflare Turnstile) ──────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── App nativa (Capacitor) ───────────────────────────────────────────────────
# bundled (recomendado, por defecto en build:android): la interfaz va dentro del
# APK y abre sin red. remote: el WebView carga CAP_SERVER_URL (modo anterior).
CAP_MODE=bundled
# Solo bundled: servidor https de la API (respaldo, cuentas, ARCO, citas). Pública.
NEXT_PUBLIC_API_BASE_URL=
# Solo remote: dominio https que carga el WebView y host de los App Links (sin barra final).
CAP_SERVER_URL=
# Huella SHA-256 del certificado de firma de Android (AA:BB:… de 32 bytes).
# Varias separadas por coma (subida y Play App Signing). Solo servidor.
ANDROID_SHA256_FINGERPRINT=
# Firma del release: mejor en android/keystore.properties (ignorado por git).
# ANDROID_KEYSTORE_PATH=
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
