<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: los datos de salud del paciente (WebView: localStorage/IndexedDB, ajustes)
     no salen del teléfono ni a la copia en la nube ni al pasar a otro equipo.
     Antes de 12 lo cubre android:allowBackup="false". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
